# ==============================================================================
# TeamSync AI - Backend Environment Configuration
# ==============================================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Keep secret! Found in Supabase > Settings > API)
# Used for server-side operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Supabase Anon Key (Public key, used as fallback)
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Frontend URL (For CORS whitelist in production)
FRONTEND_URL=https://teamsync-ai.vercel.app
