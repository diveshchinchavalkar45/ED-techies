# ==============================================================================
# TeamSync AI - Frontend Environment Configuration
# ==============================================================================

# Backend API URL (Render deployment URL, e.g. https://teamsync-ai-backend.onrender.com)
VITE_API_URL=https://your-teamsync-backend.onrender.com

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon (Public) Key (Safe for frontend use, enforces Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
